<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XppVsCode.Server</RootNamespace>
    <AssemblyName>XppVsCode.Server</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- D365FO assemblies come from the user's PackagesLocalDirectory\bin at runtime; never redistributed. -->
  <PropertyGroup>
    <D365BinPath Condition="'$(D365BinPath)' == ''">$(XPP_BIN)</D365BinPath>
  </PropertyGroup>
  <Target Name="CheckD365BinPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(D365BinPath)' == '' Or !Exists('$(D365BinPath)\Microsoft.Dynamics.AX.Metadata.dll')"
           Text="Set D365BinPath (or XPP_BIN) to PackagesLocalDirectory\bin. scripts\build-server.ps1 does this from the active configuration." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XppVsCode.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\XppCopilotSystemPrompt.txt" LogicalName="XppVsCode.Server.SystemPrompt.txt" />
    <EmbeddedResource Include="Resources\XppCopilotGuide.txt" LogicalName="XppVsCode.Server.Guide.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.Dynamics.AX.Metadata">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Metadata.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamics.AX.Metadata.Core">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Metadata.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamics.AX.Metadata.Patterns">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Metadata.Patterns.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamics.AX.Metadata.Validation">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Metadata.Validation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamics.AX.Framework.Xlnt.XppParser">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Framework.Xlnt.XppParser.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamics.AX.Framework.Xlnt.XppCore">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Framework.Xlnt.XppCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamics.AX.Metadata.Storage">
      <HintPath>$(D365BinPath)\Microsoft.Dynamics.AX.Metadata.Storage.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
