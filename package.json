          "group": "6_compare@2"
        },
        {
          "command": "xpp.openTableBrowser",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\btable\\b/",
          "group": "5_run@1"
        },
        {
          "command": "xpp.openInBrowser",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bbrowser\\b/ && !(viewItem =~ /\\btable\\b/)",
          "group": "5_run@2"
        },
        {
          "command": "xpp.tools.updateModel",
          "when": "view == xpp.aot && viewItem == 'xppModel custom'",
          "group": "1_model@1"
        },
        {
          "command": "xpp.tools.modelDependencies",
          "when": "view == xpp.aot && viewItem =~ /xppModel/",
          "group": "1_model@2"
        },
        {
          "command": "xpp.findExamples",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /xppElement/",
          "group": "4_refs@5"
        },
        {
          "command": "xpp.addToPrivilege",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bmenuitem\\b/",
          "group": "3_extend@3"
        },
        {
          "command": "xpp.generateTests",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bclass\\b/",
          "group": "5_run@4"
        },
        {
          "command": "xpp.openDesigner",
          "when": "view == xpp.security && viewItem =~ /^xppSec (role|duty|privilege|access)$/",
          "group": "navigation@1"
        },
        {
          "command": "xpp.security.analyzeLicense",
          "when": "view == xpp.security && viewItem =~ /^xppSec (role|duty|privilege)$/",
          "group": "1_security@1"
        },
        {
          "command": "xpp.security.analyzeLicense",
          "when": "view == xpp.security && viewItem =~ /^xppSec (role|duty|privilege)$/",
          "group": "inline"
        },
        {
          "command": "xpp.security.checkSod",
          "when": "view == xpp.security && viewItem == 'xppSec role'",
          "group": "1_security@2"
        },
        {
          "command": "xpp.security.report",
          "when": "view == xpp.security && viewItem == 'xppSec role'",
          "group": "1_security@3"
        },
        {
          "command": "xpp.security.whoCanAccess",
          "when": "view == xpp.security && viewItem == 'xppSec access'",
          "group": "1_security@1"
        },
        {
          "command": "xpp.security.whoCanAccess",
          "when": "view == xpp.security && viewItem == 'xppSec access'",
          "group": "inline"
        },
        {
          "command": "xpp.security.whoCanAccess",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\b(menuitem|form|table|entity)\\b/",
          "group": "4_refs@6"
        },
        {
          "command": "xpp.security.analyzeLicense",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\b(role|duty|privilege)\\b/",
          "group": "4_refs@6"
        },
        {
          "command": "xpp.security.checkSod",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\brole\\b/",
          "group": "4_refs@7"
        }
      ],
      "webview/context": [
        {
          "command": "xpp.designer.openMethod",
          "when": "webviewId == 'xppElementDesigner' && xppIsMethod",
          "group": "1_open@1"
        },
        {
          "command": "xpp.designer.new",
          "when": "webviewId == 'xppElementDesigner' && xppEditable && xppCanAdd",
          "group": "2_new@1"
        },
        {
          "command": "xpp.designer.newMethod",
          "when": "webviewId == 'xppElementDesigner' && xppEditable && xppHasMethods",
          "group": "2_new@2"
        },
        {
          "command": "xpp.designer.override",
          "when": "webviewId == 'xppElementDesigner' && xppEditable && xppHasMethods",
          "group": "2_new@3"
        },
        {
          "command": "xpp.designer.delete",
          "when": "webviewId == 'xppElementDesigner' && xppEditable && xppCanDelete",
          "group": "9_delete@1"
        },
        {
          "command": "xpp.viewCode",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bcode\\b/",
          "group": "0_navigation@2"
        },
        {
          "command": "xpp.openFormDesigner",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bform\\b/",
          "group": "0_navigation@3"
        },
        {
          "command": "xpp.addToProject",
          "when": "webviewId == 'xppElementDesigner' && xppRoot",
          "group": "0_2_project@1"
        },
        {
          "command": "xpp.deleteObject",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bcustom\\b/",
          "group": "0_9_delete@2"
        },
        {
          "command": "xpp.runTests",
          "when": "(webviewId == 'xppElementDesigner' && xppRoot =~ /\\bclass\\b/) && !xpp.localEnvironment",
          "group": "0_5_run@3"
        },
        {
          "command": "xpp.createExtension",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bextensible\\b/",
          "group": "0_3_extend@1"
        },
        {
          "command": "xpp.createCodeExtension",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bcoc\\b/",
          "group": "0_3_extend@2"
        },
        {
          "command": "xpp.findReferences",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\brefs\\b/",
          "group": "0_4_refs@1"
        },
        {
          "command": "xpp.viewReferences",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\brefs\\b/",
          "group": "0_4_refs@2"
        },
        {
          "command": "xpp.viewHierarchy",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bhier\\b/",
          "group": "0_4_refs@3"
        },
        {
          "command": "xpp.compare",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bcode\\b/",
          "group": "0_6_compare@1"
        },
        {
          "command": "xpp.compareMetadata",
          "when": "webviewId == 'xppElementDesigner' && xppRoot",
          "group": "0_6_compare@2"
        },
        {
          "command": "xpp.openTableBrowser",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\btable\\b/",
          "group": "0_5_run@1"
        },
        {
          "command": "xpp.openInBrowser",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bbrowser\\b/ && !(xppRoot =~ /\\btable\\b/)",
          "group": "0_5_run@2"
        },
        {
          "command": "xpp.designer.copyEventHandler",
          "when": "webviewId == 'xppElementDesigner' && (xppIsEvent || xppIsMethod)",
          "group": "1_open@2"
        },
        {
          "command": "xpp.designer.findEventHandlers",
          "when": "webviewId == 'xppElementDesigner' && xppHasEvents",
          "group": "1_open@3"
        },
        {
          "command": "xpp.viewErd",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\btable\\b/",
          "group": "0_4_refs@4"
        },
        {
          "command": "xpp.findExamples",
          "when": "webviewId == 'xppElementDesigner' && xppRoot",
          "group": "0_4_refs@5"
        },
        {
          "command": "xpp.addToPrivilege",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bmenuitem\\b/",
          "group": "0_3_extend@3"
        },
        {
          "command": "xpp.generateTests",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\bclass\\b/",
          "group": "0_5_run@4"
        },
        {
          "command": "xpp.security.whoCanAccess",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\b(menuitem|form|table|entity)\\b/",
          "group": "0_4_refs@6"
        },
        {
          "command": "xpp.security.analyzeLicense",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\b(role|duty|privilege)\\b/",
          "group": "0_4_refs@6"
        },
        {
          "command": "xpp.security.checkSod",
          "when": "webviewId == 'xppElementDesigner' && xppRoot =~ /\\brole\\b/",
          "group": "0_4_refs@7"
        }
      ],
      "commandPalette": [
        {
          "command": "xpp.openDesigner",
          "when": "false"
        },
        {
          "command": "xpp.viewCode",
          "when": "false"
        },
        {
          "command": "xpp.designer.new",
          "when": "false"
        },
        {
          "command": "xpp.designer.newMethod",
          "when": "false"
        },
        {
          "command": "xpp.designer.override",
          "when": "false"
        },
        {
          "command": "xpp.designer.openMethod",
          "when": "false"
        },
        {
          "command": "xpp.designer.delete",
          "when": "false"
        },
        {
          "command": "xpp.deleteObject",
          "when": "false"
        },
        {
          "command": "xpp.excludeFromProject",
          "when": "false"
        },
        {
          "command": "xpp.codeIntel.toggle",
          "when": "false"
        },
        {
          "command": "xpp.designer.copyEventHandler",
          "when": "false"
        },
        {
          "command": "xpp.designer.findEventHandlers",
          "when": "false"
        },
        {
          "command": "xpp.security.clearFilter",
          "when": "xpp.security.filtered"
        },
        {
          "command": "xpp.pac.signIn",
          "when": "!xpp.localEnvironment"
        },
        {
          "command": "xpp.pac.init",
          "when": "!xpp.localEnvironment"
        },
        {
          "command": "xpp.pac.deploy",
          "when": "!xpp.localEnvironment"
        },
        {
          "command": "xpp.debug.start",
          "when": "!xpp.localEnvironment"
        },
        {
          "command": "xpp.runTests",
          "when": "!xpp.localEnvironment"
        }
      ],
      "editor/title": [
        {
          "command": "xpp.runSnippet",
          "when": "editorLangId == xpp && resourceScheme == untitled",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xpp.openObject",
        "key": "ctrl+alt+o"
      },
      {
        "command": "xpp.build",
        "key": "ctrl+shift+b",
        "when": "resourceScheme == xpp || resourceExtname == .rnrproj"
      },
      {
        "command": "xpp.searchCode",
        "key": "ctrl+shift+alt+f",
        "when": "editorLangId == xpp || focusedView == xpp.aot || focusedView == xpp.project || focusedView == xpp.tools || focusedView == xpp.infolog"
      }
    ],
    "configuration": {
      "title": "X++",
      "properties": {
        "xpp.project": {
          "type": "string",
          "default": "",
          "description": "Full path of the D365FO project (.rnrproj) that new objects are added to. Defaults to the first .rnrproj in the workspace."
        },
        "xpp.environmentUrl": {
          "type": "string",
          "default": "",
          "description": "Dataverse URL of your default unified developer environment, e.g. https://yourorg.crm.dynamics.com. X++: Select Environment chooses another one per workspace."
        },
        "xpp.auth.clientId": {
          "type": "string",
          "default": "",
          "description": "Optional Microsoft Entra app (client) ID to sign in with, if your tenant does not allow VS Code's default sign-in for Dataverse."
        },
        "xpp.build.crossReference": {
          "type": "boolean",
          "default": true,
          "description": "Update the cross-reference database while building, so where-used includes your code."
        },
        "xpp.build.runAppCheckerRules": {
          "type": "boolean",
          "default": false,
          "description": "Run AppChecker rules during the build."
        },
        "xpp.pacPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Power Platform CLI (pac). Defaults to pac on PATH."
        },
        "xpp.debuggerProxyPath": {
          "type": "string",
          "default": "",
          "description": "Path to Microsoft.Dynamics.AX.DebuggerProxy.exe. Defaults to the FinOps tools installed by X++: Connect to Environment."
        },
        "xpp.financeAndOperationsUrl": {
          "type": "string",
          "default": "",
          "description": "Web client URL (e.g. https://yourorg.operations.dynamics.com) for Open in Browser and Open Table Browser, when the selected environment's configuration has none."
        },
        "xpp.codeIntelligence.outline": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Outline and breadcrumbs: methods and members of the open object. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.navigation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Go to Implementations (overrides, Chain of Command, event handlers, subclasses), call hierarchy and type hierarchy. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.workspaceSymbols": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Go to Symbol in Workspace (Ctrl+T) over elements and methods of all models. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.completion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Completion after . and ::, label references in strings, keywords; signature help. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.hover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Hover details: label texts, EDT and enum details, method signatures. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Code lens: reference, override, Chain of Command and handler counts; what a CoC or handler method wraps. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.syntaxCheck": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Live syntax check with the X++ compiler parser. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.obsoleteWarnings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Obsolete API warnings: calls to methods and uses of classes and tables marked `[SysObsolete]` are reported in Problems (as errors when the attribute says so). Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.formatting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Format Document / Format Selection with a 4-space Allman layout. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.eventHandlerIndex": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "(Slow the first time) Include form and data event handlers ([FormControlEventHandler], [DataEventHandler], ...), which the cross-reference database does not record. The first scan takes about a minute and is cached. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.semanticHighlighting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "(Slow) Semantic highlighting: colour classes, tables, enums, EDTs, methods and fields. Looks up every identifier of the open document. Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.codeIntelligence.diagnosticsOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "(Slow) Build the project with the X++ compiler after saving code, so semantic errors reach Problems (about 10 s per save). Also switchable in the Dynamics 365 view under Code Intelligence."
        },
        "xpp.erd.depth": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Levels of related tables the entity relationship diagram (ERD) follows from the table it starts from. Also adjustable in the diagram."
        },
        "xpp.erd.direction": {
          "type": "string",
          "default": "outgoing",
          "enum": [
            "outgoing",
            "incoming",
            "both"
          ],
          "enumDescriptions": [
            "Tables the table refers to (its relations)",
            "Tables that refer to the table (their relations to it)",
            "Both"
          ],
          "description": "Which relations the ERD follows."
        },
        "xpp.erd.fields": {
          "type": "string",
          "default": "keys",
          "enum": [
            "keys",
            "all"
          ],
          "enumDescriptions": [
            "Primary key and the fields of the drawn relations",
            "All fields"
          ],
          "description": "Fields shown in each ERD table box."
        },
        "xpp.security.sodRulesFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Segregation of duties rules (JSON: `Name`, `First`, `Second`, `Severity`, `Reason`; `First` and `Second` are duty names). Empty uses the built-in rules. **X++: Edit Segregation of Duties Rules** creates the file from the built-in rules. A relative path is under the first workspace folder."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-server.ps1",
    "build": "npm run build:server && npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.6.0"
  },
  "preview": true
}
