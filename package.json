{
  "name": "xpp-vscode",
  "displayName": "F&O Studio for VS Code",
  "description": "A full Dynamics 365 Finance & Operations development environment in VS Code: Application Explorer, designers, X++ code, build, deploy, debugging, and AI agent tools.",
  "version": "0.10.0",
  "publisher": "MNazmi",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2a1b5c",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazmolla/xpp-vscode.git"
  },
  "homepage": "https://github.com/nazmolla/xpp-vscode#readme",
  "bugs": {
    "url": "https://github.com/nazmolla/xpp-vscode/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "AI"
  ],
  "keywords": [
    "Dynamics 365",
    "Finance and Operations",
    "F&O",
    "X++",
    "D365FO",
    "ERP",
    "MCP"
  ],
  "os": [
    "win32"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.rnrproj",
    "onFileSystem:xpp",
    "onStartupFinished"
  ],
  "contributes": {
    "languageModelTools": [
      {
        "name": "xpp_run_tests",
        "displayName": "Run X++ tests",
        "toolReferenceName": "xppRunTests",
        "canBeReferencedInPrompt": true,
        "icon": "$(beaker)",
        "modelDescription": "Runs X++ unit tests (SysTestCase classes) on the connected unified developer environment's cloud runtime, the same way Visual Studio's Test Explorer does, and returns pass/fail per test with assertion messages and infolog. Tests run against the code DEPLOYED to the environment: build with xpp_build and deploy the package (Dynamics 365 > Deploy) first, otherwise the old code is tested. Without classes it runs every test class of the active project. Test classes extend SysTestCase; test methods are public and start with 'test' or carry [SysTestMethod]. Write tests that create their own data and assert with this.assertEquals/assertTrue.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "classes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Test class names. Omit to run all test classes of the active project."
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only these test methods (names) of the given classes."
            },
            "timeoutMinutes": {
              "type": "number",
              "description": "How long to wait for results. Default 30."
            }
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "xpp"
      }
    ],
    "debuggers": [
      {
        "type": "xpp",
        "label": "X++ (Dynamics 365 unified developer environment)",
        "languages": [
          "xpp"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "processName": {
                "type": "string",
                "default": "AXHost.exe",
                "description": "Process to attach to in the environment."
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              },
              "sourceFileMap": {
                "type": "object",
                "description": "Extra source path mappings."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "xpp",
            "request": "attach",
            "name": "Attach to Dynamics 365 (unified developer environment)"
          }
        ],
        "configurationSnippets": [
          {
            "label": "X++: Attach to Dynamics 365",
            "body": {
              "type": "xpp",
              "request": "attach",
              "name": "Attach to Dynamics 365 (unified developer environment)"
            }
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "xpp.mcp",
        "label": "F&O Studio (Dynamics 365 F&O)"
      }
    ],
    "languages": [
      {
        "id": "xpp",
        "aliases": [
          "X++",
          "xpp"
        ],
        "extensions": [
          ".xpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xpp",
        "scopeName": "source.xpp",
        "path": "./syntaxes/xpp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xpp",
        "path": "./snippets/xpp.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xpp",
          "title": "F&O Studio",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "xpp": [
        {
          "id": "xpp.aot",
          "name": "Application Explorer"
        },
        {
          "id": "xpp.project",
          "name": "D365FO Project"
        },
        {
          "id": "xpp.security",
          "name": "Security",
          "visibility": "collapsed"
        },
        {
          "id": "xpp.tools",
          "name": "Dynamics 365"
