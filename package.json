          "group": "4_refs@4"
        },
        {
          "command": "xpp.compare",
          "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bcode\\b/",
          "group": "6_compare@1"
        },
        {
          "command": "xpp.compareMetadata",
