    },
    "viewsWelcome": [
      {
        "view": "xpp.aot",
        "contents": "No D365FO metadata found on this machine.\n[Connect to Environment](command:xpp.connectEnvironment)"
      },
      {
        "view": "xpp.project",
        "when": "!xpp.hasProject",
        "contents": "No D365FO project selected. A project groups your work and decides the folders this window shows (the project folder and its model folder); the Application Explorer and agent tools also work without one.\n[Select D365FO Project](command:xpp.selectProject)\n[Create D365FO Project](command:xpp.createProject)"
      },
      {
        "view": "xpp.project",
        "when": "xpp.hasProject",
        "contents": "The project has no objects yet. Add objects with Add to Project in the Application Explorer or create them with the agent tools. To switch projects, use the Select or Create D365FO Project buttons in this view's title bar."
      }
